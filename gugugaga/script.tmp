const L={zh:{title:'個人行程與任務管理系統',tagline:'把重要的事安排好，讓每一天都從容一點。',add:'＋ 新增行程',schedule:'今日行程',tasks:'今日待辦',focus:'今日專注',hours:'小時規劃',addTask:'＋ 新增待辦',new:'新增行程',name:'行程名稱',date:'日期',start:'開始時間',end:'結束時間',location:'地點（選填）',category:'類別',personal:'個人安排',work:'工作會議',cancel:'取消',save:'儲存',footer:'今天也為自己留一點喘息的時間 ☁',unit:'個安排',done:'已完成',pending:'待完成',empty:'這天還沒有行程。',del:'刪除',confirm:'確定刪除？',bad:'結束時間須晚於開始時間',saved:'行程已儲存',coffee:'晨間規劃與咖啡時光',meeting:'產品設計週會',shopping:'採買生活用品',loc1:'日光咖啡・中山店',loc2:'會議室 A／線上會議',loc3:'誠品生活南西',task1:'整理本週會議重點',task2:'寄出設計稿給團隊確認',task3:'預約下週牙醫回診',prompt:'請輸入待辦事項',exported:'JSON 備份已匯出'},en:{title:'Personal Schedule & Task Manager',tagline:'Plan what matters and make each day a little easier.',add:'＋ Add event',schedule:"Today's schedule",tasks:"Today's tasks",focus:'Focus time',hours:'hours planned',addTask:'＋ Add task',new:'Add event',name:'Event name',date:'Date',start:'Start time',end:'End time',location:'Location (optional)',category:'Category',personal:'Personal',work:'Work meeting',cancel:'Cancel',save:'Save',footer:'Leave a little room to breathe ☁',unit:'events',done:'Completed',pending:'Pending',empty:'No events for this day.',del:'Delete',confirm:'Delete this event?',bad:'End time must be after start time',saved:'Event saved',coffee:'Morning planning & coffee',meeting:'Product design weekly sync',shopping:'Pick up household essentials',loc1:'Daylight Café · Zhongshan',loc2:'Meeting Room A / Online',loc3:'Eslite Spectrum Nanxi',task1:'Organize this week’s meeting notes',task2:'Send the design draft to the team',task3:'Book next week’s dentist appointment',prompt:'Enter a task',exported:'JSON backup exported'},ja:{title:'個人スケジュール・タスク管理',tagline:'大切な予定を整えて、毎日を心地よく。',add:'＋ 予定を追加',schedule:'今日の予定',tasks:'今日のタスク',focus:'集中時間',hours:'時間を計画',addTask:'＋ タスクを追加',new:'予定を追加',name:'予定名',date:'日付',start:'開始時間',end:'終了時間',location:'場所（任意）',category:'カテゴリー',personal:'個人',work:'仕事の会議',cancel:'キャンセル',save:'保存',footer:'今日もひと息つく時間を ☁',unit:'件',done:'完了',pending:'未完了',empty:'この日の予定はありません。',del:'削除',confirm:'予定を削除しますか？',bad:'終了時間は開始時間より後にしてください',saved:'予定を保存しました',coffee:'朝の予定確認とコーヒー',meeting:'デザイン週次会議',shopping:'日用品の買い出し',loc1:'日光カフェ・中山店',loc2:'会議室 A／オンライン',loc3:'誠品生活 南西',task1:'今週の会議メモを整理する',task2:'デザイン案をチームに送る',task3:'来週の歯科予約を取る',prompt:'タスクを入力してください',exported:'JSON を書き出しました'}};
const seed=[['a','2026-10-16','09:00','10:00','coffee','loc1','personal'],['b','2026-10-16','11:00','12:30','meeting','loc2','work'],['c','2026-10-16','15:00','16:00','shopping','loc3','personal']];let lang='zh',date='2026-10-16',events=seed.map(x=>({id:x[0],date:x[1],start:x[2],end:x[3],title:x[4],loc:x[5],category:x[6],sample:true})),tasks=[{title:'task1',done:true},{title:'task2',done:false},{title:'task3',done:false}];const $=id=>document.getElementById(id),t=k=>L[lang][k]||k,esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function save(){try{localStorage.setItem('planner-local-v1',JSON.stringify({events,tasks,lang}))}catch{}}function message(s){$('toast').textContent=s;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2000)}

<header class="topbar"><div class="brand"><span class="brand-mark">◷</span><select id="lang" class="language-select"><option value="zh">繁體中文</option><option value="en">English</option><option value="ja">日本語</option></select></div><button id="export" class="tool-button">匯出 JSON</button></header>
<main><section class="welcome"><div><p class="eyebrow">PERSONAL PLANNER</p><h1 data-t="title">個人行程與任務管理系統</h1><p class="subtitle" data-t="tagline">把重要的事安排好，讓每一天都從容一點。</p></div><button class="primary-button" id="add" data-t="add">＋ 新增行程</button></section>
<section class="stats"><article class="stat-card"><p class="stat-label" data-t="schedule">今日行程</p><p class="stat-value" id="eventCount"></p></article><article class="stat-card"><p class="stat-label" data-t="tasks">今日待辦</p><p class="stat-value" id="taskCount"></p></article><article class="stat-card"><p class="stat-label" data-t="focus">今日專注</p><p class="stat-value">6.5 <small data-t="hours">小時規劃</small></p></article></section>
<section class="content-grid"><article class="panel"><header class="panel-header"><div><h2 class="panel-title" data-t="schedule">今日行程</h2></div><div class="date-nav"><button class="icon-button" id="prev">‹</button><span id="dateLabel" class="date-label"></span><input id="picker" class="date-picker" type="date"><button class="icon-button" id="next">›</button></div></header><div id="events" class="schedule"></div></article><article class="panel"><header class="panel-header"><h2 class="panel-title" data-t="tasks">今日待辦</h2><span id="progress"></span></header><div id="tasks" class="task-list"></div><footer class="task-footer"><button id="addTask" class="add-task" data-t="addTask">＋ 新增待辦</button></footer></article></section><footer class="bottom-note" data-t="footer">今天也為自己留一點喘息的時間 ☁</footer></main>
<dialog id="dialog" class="form-dialog"><form id="form"><h2 data-t="new">新增行程</h2><div class="form-field"><label data-t="name">名稱</label><input name="title" required maxlength="100"></div><div class="form-field"><label data-t="date">日期</label><input name="date" type="date" required></div><div class="form-field"><label data-t="start">開始</label><input name="start" type="time" required></div><div class="form-field"><label data-t="end">結束</label><input name="end" type="time" required></div><div class="form-field"><label data-t="location">地點</label><input name="location" maxlength="120"></div><div class="form-field"><label data-t="category">類別</label><select name="category"><option value="personal" data-t="personal">個人</option><option value="work" data-t="work">工作</option></select></div><div class="dialog-actions"><button type="button" id="cancel" data-t="cancel">取消</button><button class="save-button" data-t="save">儲存</button></div></form></dialog><div class="toast" id="toast"></div>

<body>
<script>
$('lang').onchange=()=>{lang=$('lang').value;persist();render()};$('prev').onclick=()=>shift(-1);$('next').onclick=()=>shift(1);$('picker').onchange=()=>{if($('picker').value){date=$('picker').value;render()}};
$('add').onclick=()=>{$('eventForm').reset();$('eventForm').elements.date.value=date;$('dialog').showModal()};$('cancel').onclick=()=>$('dialog').close();$('eventForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.currentTarget),start=f.get('start'),end=f.get('end');if(end<=start){notify(tr('invalid'));return}events.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),date:f.get('date'),start,end,title:f.get('title').trim(),loc:f.get('location').trim(),category:f.get('category')});date=f.get('date');persist();$('dialog').close();render();notify(tr('saved'))};
$('addTask').onclick=()=>{const value=prompt(tr('enterTask'));if(value?.trim()){tasks.push({title:value.trim(),done:false});persist();render()}};
$('export').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({events,tasks,lang},null,2)],{type:'application/json'}));a.download='planner-data.json';a.click();URL.revokeObjectURL(a.href);notify(tr('exported'))};
try{const saved=JSON.parse(localStorage.getItem('planner-data'));if(saved&&Array.isArray(saved.events)&&Array.isArray(saved.tasks)){events=saved.events;tasks=saved.tasks;if(D[saved.lang])lang=saved.lang}}catch{}render();
function notify(message){$('toast').textContent=message;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2200)}
</script></body></html>